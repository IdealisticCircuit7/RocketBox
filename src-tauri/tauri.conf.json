{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RocketBox",
  "version": "1.0.0",
  "identifier": "com.bruno.rocket-box",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "RocketBox by OCSIS",
        "dragDropEnabled": false,
        "width": 1280,
        "height": 800,
        "minWidth": 640,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "OCSIS",
    "copyright": "Copyright © OCSIS",
    "shortDescription": "Biblioteca desktop de assets e assistente NautIA",
    "longDescription": "RocketBox by OCSIS — Organização de assets, pastas virtuais, pré-visualização 3D e assistente local NautIA.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["PortugueseBR", "English"],
        "displayLanguageSelector": false
      }
    }
  }
}
